[gateway]
; Which box this is. Stamped on every row as `source`, so several scanning
; Pis can pool observations into one db without colliding. Defaults to the
; hostname if omitted. Keep it stable -- changing it orphans that gateway's
; history and re-syncs it under the new name.
name = jcb-pi

[device:Bedroom]
mac = AA:BB:CC:DD:EE:FF
alert = yes

[device:Living Room]
mac = 11:22:33:44:55:66
alert = no

[alerts]
humidity_min = 30.0
humidity_max = 70.0
temp_min = 10.0
temp_max = 30.0
alert_cooldown_minutes = 60
; How stale the freshest reading may be and still be alerted on. Alerting
; reads the MERGED store (all gateways), so this must comfortably exceed
; scan interval + sync interval -- a remote gateway's row only lands here
; after sync-gateways.sh runs. Absence itself is never alerted on.
max_reading_age_minutes = 20
; Reference sensor quoted in every alert SMS, so an alert distinguishes "the
; whole flat is dry" from "this one case is dry" -- opposite actions. Must name
; a [device:...] section; it need NOT be an alerting one, and a room sensor
; should stay alert = no (room RH swings ~27 points a day on temperature alone
; and would cry wolf against case thresholds). Omit for uncaptioned alerts.
context_device = Living Room
sender_id = BLE Gateway

[sampling]
interval_seconds = 300

[twilio]
account_sid = ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
auth_token = your_auth_token_here
messaging_service_sid = MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
to_phone = +1234567890
